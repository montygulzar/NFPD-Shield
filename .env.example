# =====================================================================
# NFPD Shield - environment contract (EXAMPLE ONLY - NO REAL SECRETS)
# =====================================================================
# This file is consumed in two ways:
#   1. python-dotenv style, for local development (shield loads .env only
#      when SHIELD_LOAD_DOTENV=true).
#   2. systemd EnvironmentFile=, for production.
#
# IMPORTANT - systemd EnvironmentFile is NOT python-dotenv:
#   * no `export` keyword
#   * no shell expansion ($VAR, $(cmd), backticks are literal text)
#   * no inline comments after a value on the same line
#   * quotes are mostly literal; keep every value simple and unquoted
# Keep values plain ASCII, one KEY=VALUE per line, comments on their own line.
#
# Secrets live ONLY in the process environment. Never commit a real token.
# Production file permissions MUST be 0600, owned by the service user.

# ---------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------
# Discord bot token from the Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=REPLACE_ME_WITH_BOT_TOKEN

# Discord application (client) ID - a snowflake, 17-20 digits.
APPLICATION_ID=000000000000000000

# PostgreSQL DSN. The driver is optional: a plain postgresql:// URL is upgraded
# to asyncpg automatically, so this can be written the same way as every other
# service on the host.
#
# IMPORTANT - Shield needs its OWN database. Do not point it at the mod bot's
# database: both projects define a `guild_settings` table with different
# columns, and sharing one would break both. See docs/DOCKER.md.
#
# Docker (default): the host is the PostgreSQL CONTAINER NAME, because containers
# on the same user-defined network resolve each other by name. Not localhost -
# inside Shield's container that points at Shield itself.
DATABASE_URL=postgresql://nfpd_shield:REPLACE_ME@nfpd-postgres:5432/nfpd_shield
# Bare-metal / systemd deployment:
# DATABASE_URL=postgresql://nfpd_shield:REPLACE_ME@127.0.0.1:5432/nfpd_shield
# A routable remote host MUST use TLS; append ?ssl=require (asyncpg spelling):
# DATABASE_URL=postgresql://nfpd_shield:REPLACE_ME@db.example.com:5432/nfpd_shield?ssl=require

# Alternative to DATABASE_URL: set these and the URL is assembled from them
# (handy when the same values are already passed to the PostgreSQL container).
# Special characters in the password are percent-encoded automatically.
# DATABASE_URL wins if both are set.
#POSTGRES_USER=nfpd_shield
#POSTGRES_PASSWORD=
#POSTGRES_HOST=nfpd-postgres
#POSTGRES_PORT=5432
#POSTGRES_DB=nfpd_shield

# TLS enforcement. Unset, Shield requires TLS for any routable host and does not
# for loopback, a Unix socket, or a single-label hostname (a container or LAN
# name such as nfpd-postgres). Set it explicitly to override that judgement.
#DB_REQUIRE_TLS=true

# ---------------------------------------------------------------------
# BOT OPERATOR IDENTITY
# ---------------------------------------------------------------------
# Global bot operator / developer user ID. OWNERID is the canonical name;
# OWNER_ID and SHIELD_OWNER_ID are accepted aliases.
# NOTE: the operator is NOT automatically exempt from any guild's
# protections. It only unlocks operator-scoped diagnostics.
OWNERID=000000000000000000

# Optional comma-separated additional operator IDs (co-maintainers).
EXTRA_OPERATOR_IDS=

# ---------------------------------------------------------------------
# INTENTS / FEATURE SWITCHES
# ---------------------------------------------------------------------
# Message content inspection (spam + mention detection on content).
# Requires the privileged MESSAGE CONTENT intent to be approved and
# enabled in the Developer Portal. Set false to run without it; message
# spam detection then degrades to metadata-only counting.
ENABLE_MESSAGE_CONTENT=true

# Guild Members privileged intent (joins, member state, role diffs).
ENABLE_GUILD_MEMBERS=true

# ---------------------------------------------------------------------
# GLOBAL DEFAULTS (bootstrap only - per-guild values live in PostgreSQL)
# ---------------------------------------------------------------------
# Mode applied to a guild the first time Shield sees it.
# One of: alert_only | enforce | lockdown
DEFAULT_MODE=alert_only

# Global dry-run master switch. When true, no enforcement call is ever
# executed; every decision is logged and reported as would-have-done.
GLOBAL_DRY_RUN=false

# Snapshot cadence and retention defaults.
SNAPSHOT_INTERVAL_MINUTES=360
SNAPSHOT_RETENTION=12

# Audit-log correlation tuning (seconds).
AUDIT_CORRELATION_DELAY=1.5
AUDIT_CORRELATION_WINDOW=20
AUDIT_MAX_ATTEMPTS=3

# Outbound notification budget per guild (token bucket).
NOTIFY_BURST=5
NOTIFY_REFILL_SECONDS=30

# Enforcement budget per guild (token bucket) - caps automated writes.
ENFORCE_BURST=5
ENFORCE_REFILL_SECONDS=20

# ---------------------------------------------------------------------
# SNAPSHOT ENCRYPTION (optional but recommended)
# ---------------------------------------------------------------------
# urlsafe-base64 32-byte Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When unset, snapshots are stored as plaintext JSON in PostgreSQL.
SNAPSHOT_ENCRYPTION_KEY=

# Store webhook metadata in snapshots (names/channels only, never tokens).
SNAPSHOT_INCLUDE_WEBHOOKS=true

# ---------------------------------------------------------------------
# DATABASE POOL
# ---------------------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_COMMAND_TIMEOUT=30

# Container start-up only: how long the entrypoint waits for PostgreSQL to accept
# connections before giving up. PostgreSQL is a separate container with its own
# lifecycle, so "not up yet" is normal rather than an error.
#DB_WAIT_MAX_SECONDS=300

# ---------------------------------------------------------------------
# HEALTH ENDPOINT
# ---------------------------------------------------------------------
# Serves GET /health (liveness) and GET /ready (readiness) for the Docker
# HEALTHCHECK and any monitoring on the shared network. Both are read-only and
# expose no guild data, configuration or secrets. The compose file does not
# publish the port to the host, so it is reachable only inside the network.
#HEALTH_SERVER_ENABLED=true
#HEALTH_HOST=0.0.0.0
#HEALTH_PORT=8080

# ---------------------------------------------------------------------
# DOCKER (optional)
# ---------------------------------------------------------------------
# Memory ceiling for the container. Default 512M.
#DOCKER_MEMORY_LIMIT=512M
# Normally passed as build args rather than set here; they are stamped into the
# image so /health and /shield health report the running build.
#APP_VERSION=1.0.0
#GIT_COMMIT=

# ---------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
# Optional file sink; omit to log to stdout only (recommended under systemd).
LOG_FILE=
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUPS=5

# ---------------------------------------------------------------------
# RUNTIME / SHARDING
# ---------------------------------------------------------------------
# Shield coordinates per-guild incidents with PostgreSQL advisory locks, so
# multiple processes are safe. Set a stable identifier per process.
INSTANCE_ID=shield-1
# Total shard count; leave empty for discord.py autosharding.
SHARD_COUNT=
SHARD_IDS=

# Local development only: load ./.env before validating config.
SHIELD_LOAD_DOTENV=false

# Guild IDs to sync slash commands to instantly (comma separated).
# Leave empty for global command registration (can take up to 1 hour).
DEV_GUILD_IDS=

# Data retention in days for incidents/event log (0 disables pruning).
RETENTION_INCIDENT_DAYS=180
RETENTION_EVENT_DAYS=30

# Apply `alembic upgrade head` at start-up.
#
# Under Docker the container entrypoint performs this before the bot starts (so
# schema changes stay out of the event loop) and then hands the bot this flag as
# false automatically - leave it true there.
#
# For a systemd deployment, set it false and migrate from the deploy step
# instead; always false if several instances start simultaneously.
RUN_MIGRATIONS_ON_BOOT=true
